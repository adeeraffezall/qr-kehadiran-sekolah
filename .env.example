# Firebase Web Client Configuration (Dapatkan dari Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=kehadiran-sekolah-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kehadiran-sekolah-demo
VITE_FIREBASE_STORAGE_BUCKET=kehadiran-sekolah-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Tetapan Sekolah
VITE_SCHOOL_NAME=SK SERI MAKMUR
VITE_SCHOOL_CODE=BBA1234
VITE_TIMEZONE=Asia/Kuala_Lumpur

# Mod Pembangunan / Emulator (Pilihan: true / false)
VITE_USE_FIREBASE_EMULATOR=false
